PORT=8080
# Samakan dengan REEFER_API_TOKEN di .env Laravel. Kosongkan hanya untuk development.
API_TOKEN=ganti-dengan-token-rahasia

DB_USER=root
DB_PASS=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=reefer

# HiveMQ Cloud: tls://xxxx.s1.eu.hivemq.cloud:8883 (isi user dan pass)
# HiveMQ publik (untuk uji coba): tcp://broker.hivemq.com:1883
MQTT_BROKER=tcp://broker.hivemq.com:1883
MQTT_USER=
MQTT_PASS=
MQTT_CLIENT_ID=reefer-backend
# Pakai prefix unik kalau memakai broker publik, karena topic bisa dilihat semua orang.
MQTT_TOPIC_PREFIX=reefer

TEMP_WARN=2
TEMP_CRIT=8
TEMP_HYSTERESIS=0.2
DEVICE_STALE_SECONDS=30
